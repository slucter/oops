# ============================================================
# KATALOG KREDENSIAL
# ============================================================
# File ini DI-COMMIT. Isinya hanya katalog: kredensial apa yang
# ada di projek ini, untuk apa, dan bagaimana bentuknya.
#
# NILAI ASLI ada di .env — yang TIDAK PERNAH di-commit.
#
# Agent membaca file ini untuk tahu akses apa yang tersedia,
# tanpa perlu dijelaskan ulang tiap session.
#
# Tambahkan entri dengan skill /simpan-rahasia.
#
# BOLEH ditulis di sini: nama variabel, kegunaan, hostname, port,
#   username, nama database, format nilai, file mana yang memakainya.
# TIDAK BOLEH: password, token, private key, string koneksi lengkap.
# ============================================================


# ---- Contoh bentuk entri yang benar (hapus saat dipakai) ----

# Database utama. Dipakai skrip migrasi dan test integrasi.
# Host: db.example.internal:5432 · User: app_rw · DB: appdb
# Nilai ada di .env.
# DATABASE_URL=

# SSH ke server deploy. Private key di ~/.ssh/deploy_key (bukan di repo).
# Dipakai scripts/deploy.sh.
# DEPLOY_SSH_HOST=
# DEPLOY_SSH_USER=

# API pihak ketiga <nama layanan>. Kuota <N> panggilan/hari.
# Dashboard: <url dashboard>
# Dipakai src/services/<nama>.ts
# THIRDPARTY_API_KEY=


# ---- sxops: dashboard monitoring server ----

# Port web server. Dipakai src/server.js.
PORT=3000

# Secret untuk menandatangani session cookie (express-session).
# Isi dengan string acak panjang, mis. hasil `openssl rand -hex 32`.
# Dipakai src/server.js.
SESSION_SECRET=

# Path file database SQLite. Default: data/sxops.sqlite (relatif ke root repo).
# Dipakai src/db/index.js.
# DB_PATH=

# Path file config daftar server (YAML). Default: config/servers.yaml.
# File ini TIDAK di-commit (lihat .gitignore) karena berisi topologi
# jaringan client. Salin dari config/servers.example.yaml.
# Dipakai src/services/serverConfig.js.
# SERVERS_CONFIG_PATH=

# Interval polling status server, dalam menit. Default: 2.
# Dipakai src/scheduler/index.js.
# CHECK_INTERVAL_MINUTES=

# Timeout koneksi & eksekusi command SSH, dalam milidetik. Default: 8000 / 10000.
# Dipakai src/services/sshClient.js.
# SSH_CONNECT_TIMEOUT_MS=
# SSH_COMMAND_TIMEOUT_MS=

# Private key SSH untuk tiap server DIKATALOGKAN di config/servers.yaml
# (field ssh_key, berupa path file, bukan isi key). Key itu sendiri
# disimpan di luar repo, mis. C:/keys/<nama>.key, permission dibatasi.
