<%- include('partials/layout-head', { title: 'Master Group - Oops' }) %>
<%- include('partials/navbar', { username: username, active: 'master' }) %>
  <main>
    <nav class="crumbs">
      <a href="/">&larr; Dashboard</a>
      <span class="sep">/</span>
      <span class="current">Master &middot; Group</span>
    </nav>

    <div class="page-head">
      <div>
        <h1>Master &middot; Group</h1>
        <div class="page-sub">Kelompokkan client yang terhubung ke dalam grup.</div>
      </div>
    </div>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <div class="panel panel-pad" style="margin-bottom:1.1rem;">
      <form method="post" action="/groups" class="form-row">
        <div class="field">
          <label for="new-group">Nama grup baru</label>
          <input type="text" id="new-group" name="name" required placeholder="mis. Kantor Pusat" />
        </div>
        <button type="submit" class="btn-primary">+ Add group</button>
      </form>
    </div>

    <div class="panel">
      <table>
        <thead>
          <tr>
            <th>Nama grup</th>
            <th style="width:120px;">Clients</th>
            <th style="width:110px; text-align:right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (groups.length === 0) { %>
            <tr>
              <td colspan="3">
                <div class="empty-state" style="border:0; padding:1.8rem 1rem; background:transparent;">
                  <span class="big">No groups yet</span>
                  Buat grup pertama lewat form di atas.
                </div>
              </td>
            </tr>
          <% } %>
          <% for (const g of groups) { %>
            <tr>
              <td>
                <form method="post" action="/groups/<%= g.id %>/edit" style="display:flex; gap:0.5rem; align-items:center; max-width:420px;">
                  <input type="text" name="name" value="<%= g.name %>" required />
                  <button type="submit" class="btn-sm btn-ghost">Save</button>
                </form>
              </td>
              <td class="meta num"><%= g.memberCount %></td>
              <td>
                <div class="row-actions">
                  <form method="post" action="/groups/<%= g.id %>/delete"
                        onsubmit="return confirm('Hapus grup &quot;<%= g.name %>&quot;? Client di dalamnya TIDAK ikut terhapus — mereka jadi Belum dikelompokkan.');">
                    <button type="submit" class="btn-sm btn-danger">Remove</button>
                  </form>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
<%- include('partials/layout-foot') %>
