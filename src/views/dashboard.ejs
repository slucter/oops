<%- include('partials/layout-head', { title: 'Dashboard - Oops' }) %>
<%- include('partials/navbar', { username: username, active: 'dashboard' }) %>
  <main>
    <div class="page-head">
      <div>
        <h1>Connected clients</h1>
        <div class="page-sub" id="refresh-indicator">&nbsp;</div>
      </div>
      <div class="actions">
        <button type="button" class="btn-ghost" onclick="location.reload()">Refresh</button>
        <a class="btn btn-primary" href="/clients/new">+ Add client</a>
      </div>
    </div>

    <%
      const groupNames = Object.keys(grouped);
      let criticalCount = 0, warningCount = 0, outdatedCount = 0;
      for (const g of groupNames) {
        for (const c of grouped[g]) {
          if (c.worstSeverity === 'critical') criticalCount++;
          else if (c.worstSeverity === 'warning') warningCount++;
          if (c.needsUpdate) outdatedCount++;
        }
      }
    %>
    <% if (criticalCount + warningCount > 0) { %>
      <div class="banner-alert">
        <span>⚠</span>
        <span>
          <span class="count"><%= criticalCount + warningCount %></span> client perlu perhatian
          <% if (criticalCount) { %> &middot; <%= criticalCount %> critical<% } %>
          <% if (warningCount) { %> &middot; <%= warningCount %> warning<% } %>
        </span>
      </div>
    <% } %>

    <% if (dihapus) { %>
      <% if (adaSisa) { %>
        <div class="banner-sisa">
          <span>⚠</span>
          <span>
            <b><%= dihapus %></b> dihapus dari dashboard, tapi agent di server itu
            <b>belum tercabut</b> — kemungkinan sedang offline atau menjalankan agent
            versi lama. Ia akan terus mencoba menyambung dengan token yang sudah tidak
            berlaku. Bersihkan manual di server tersebut:
            <code>systemctl --user disable --now oops-agent &amp;&amp; rm -rf ~/.oops-agent ~/.config/systemd/user/oops-agent.service</code>
          </span>
        </div>
      <% } else { %>
        <div class="banner-ok">
          <span>✓</span>
          <span><b><%= dihapus %></b> dihapus, dan agent di server itu sudah dicabut sepenuhnya.</span>
        </div>
      <% } %>
    <% } %>

    <% if (outdatedCount > 0) { %>
      <div class="banner-update">
        <span>⬆</span>
        <span>
          <span class="count"><%= outdatedCount %></span> client menjalankan agent versi lama.
          Versi terbaru: <b>v<%= latestAgentVersion %></b>
        </span>
        <button type="button" id="update-all-btn" class="btn-sm btn-primary">Update semua</button>
        <span id="update-all-status" class="update-status"></span>
      </div>
    <% } %>

    <% if (groupNames.length === 0) { %>
      <div class="empty-state">
        <span class="big">No clients registered</span>
        Tambahkan client pertama untuk mulai memantau.<br />
        <a class="server-link" href="/clients/new">+ Add client</a>
      </div>
    <% } %>

    <% for (const groupName of groupNames) { %>
      <div class="group-label">
        <%= groupName %>
        <span class="count"><%= grouped[groupName].length %></span>
      </div>
      <div class="panel">
        <table>
          <thead>
            <tr>
              <th>Client</th>
              <th>Alert</th>
              <th>Hostname</th>
              <th>IP</th>
              <th>Status</th>
              <th>Latency</th>
              <th>RAM</th>
              <th>Disk</th>
              <th>Agent</th>
              <th>Last seen</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for (const c of grouped[groupName]) { %>
              <tr>
                <td class="cell-name"><a class="server-link" href="/client/<%= c.id %>"><%= c.name %></a></td>
                <td>
                  <% if (c.alerts && c.alerts.length) { %>
                    <span class="alert-dot alert-<%= c.worstSeverity %>"
                          title="<%= c.alerts.map(function(a){ return a.message; }).join(' | ') %>">
                      ⚠ <%= c.alerts.length %>
                    </span>
                  <% } else { %>
                    <span class="alert-dot alert-ok">OK</span>
                  <% } %>
                </td>
                <td class="meta cell-host" title="<%= c.hostname || '' %>"><%= c.hostname || '—' %></td>
                <td class="cell-ip">
                  <% if (c.privateIp || c.publicIp) { %>
                    <span class="ip-stack">
                      <span class="ip-priv"><%= c.privateIp || '—' %></span>
                      <% if (c.publicIp) { %><span class="ip-pub"><%= c.publicIp %></span><% } %>
                    </span>
                  <% } else { %>
                    <span class="meta">—</span>
                  <% } %>
                </td>
                <td><span class="badge badge-<%= c.status %>"><%= c.status.toUpperCase() %></span></td>
                <td class="num"><%- include('partials/latency', { ms: c.status === 'up' ? c.lastLatencyMs : null }) %></td>
                <td class="num"><%- include('partials/usage-bar', { percent: c.metric ? c.metric.memPercent : null }) %></td>
                <td class="num"><%- include('partials/usage-bar', { percent: c.metric ? c.metric.diskPercent : null }) %></td>
                <td>
                  <% if (c.status === 'pending') { %>
                    <span class="meta">—</span>
                  <% } else if (c.needsUpdate) { %>
                    <span class="agent-ver agent-old"
                          title="Terpasang: v<%= c.agentVersion || 'lama (tidak melaporkan versi)' %> &middot; tersedia: v<%= latestAgentVersion %>">
                      v<%= c.agentVersion || '?' %> ⬆
                    </span>
                  <% } else { %>
                    <span class="agent-ver agent-ok" title="Sudah versi terbaru">v<%= c.agentVersion %></span>
                  <% } %>
                </td>
                <td class="meta num cell-time"><%= c.lastSeenAt || 'never' %></td>
                <td class="cell-actions">
                  <div class="row-actions">
                    <% if (c.needsUpdate && c.status === 'up') { %>
                      <button type="button" class="btn-sm btn-primary update-agent-btn"
                              data-id="<%= c.id %>" data-name="<%= c.name %>">Update</button>
                    <% } %>
                    <a class="btn btn-sm btn-ghost" href="/client/<%= c.id %>">Detail</a>
                    <a class="btn btn-sm btn-ghost" href="/clients/<%= c.id %>/edit">Edit</a>
                    <form method="post" action="/clients/<%= c.id %>/delete"
                          onsubmit="return confirm('Hapus client &quot;<%= c.name %>&quot;?\n\nAgent di server itu akan dicabut sepenuhnya: service dimatikan, dihapus dari systemd, dan folder ~/.oops-agent dihapus.\n\nSemua data metrik, riwayat, dan alert-nya ikut terhapus permanen.');">
                      <button type="submit" class="btn-sm btn-danger">Remove</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <script>
    (function () {
      var REFRESH_MS = 30000;
      var secondsLeft = REFRESH_MS / 1000;
      var indicator = document.getElementById('refresh-indicator');

      // Update agent bisa memakan beberapa menit. Auto-refresh di tengahnya
      // akan membatalkan permintaan fetch dan membuat hasilnya tidak pernah
      // terlihat — jadi refresh ditahan selama ada update berjalan.
      var updating = 0;

      setInterval(function () {
        if (updating > 0) {
          indicator.textContent = 'auto refresh ditahan — update agent sedang berjalan';
          secondsLeft = REFRESH_MS / 1000;
          return;
        }
        secondsLeft -= 1;
        if (secondsLeft <= 0) { location.reload(); return; }
        indicator.textContent = 'auto refresh in ' + secondsLeft + 's';
      }, 1000);

      function jalankanUpdate(url, tombol, statusEl, labelSelesai) {
        updating++;
        var labelAwal = tombol.textContent;
        tombol.disabled = true;
        tombol.textContent = 'Updating…';
        if (statusEl) statusEl.textContent = 'Mengunduh & memasang, bisa beberapa menit…';

        return fetch(url, { method: 'POST', headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json().catch(function () { return { error: 'Balasan server tidak terbaca.' }; }); })
          .then(function (data) {
            if (data.error) throw new Error(data.error);
            if (statusEl) statusEl.textContent = data.message || labelSelesai;
            tombol.textContent = 'Selesai ✓';
            // Muat ulang supaya versi baru yang dilaporkan agent terlihat.
            // Diberi jeda karena agent baru mengirim metrik (dengan versi
            // barunya) setelah ia selesai restart dan terhubung lagi.
            setTimeout(function () { location.reload(); }, 8000);
          })
          .catch(function (err) {
            tombol.disabled = false;
            tombol.textContent = labelAwal;
            if (statusEl) statusEl.textContent = 'Gagal: ' + err.message;
            else alert('Update gagal: ' + err.message);
          })
          .then(function () { updating--; });
      }

      document.querySelectorAll('.update-agent-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var nama = btn.getAttribute('data-name');
          if (!confirm('Update agent di "' + nama + '"?\n\nAgent akan mengunduh versi terbaru lalu restart. Client sempat terputus beberapa detik.')) return;
          var status = document.getElementById('update-all-status');
          jalankanUpdate('/clients/' + btn.getAttribute('data-id') + '/update-agent', btn, status, 'Update selesai.');
        });
      });

      var allBtn = document.getElementById('update-all-btn');
      if (allBtn) {
        allBtn.addEventListener('click', function () {
          if (!confirm('Update agent di semua client yang tertinggal versi?\n\nDikerjakan satu per satu. Kalau ada yang gagal, sisanya dihentikan supaya masalahnya tidak menyebar.')) return;
          jalankanUpdate('/clients/update-agent-all', allBtn, document.getElementById('update-all-status'), 'Semua selesai.');
        });
      }
    })();
  </script>
<%- include('partials/layout-foot') %>
