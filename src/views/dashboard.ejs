<%- include('partials/layout-head', { title: 'Dashboard - sxops' }) %>
  <header>
    <a href="/">sxops</a>
    <div>
      <a href="/groups" class="server-link" style="margin-right: 1rem;">Master Group</a>
      <span class="meta"><%= username %></span>
      <form class="inline" method="post" action="/logout">
        <button type="submit">Keluar</button>
      </form>
    </div>
  </header>
  <main>
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h1>Status Client</h1>
      <div>
        <span class="meta" id="refresh-indicator"></span>
        <button type="button" onclick="location.reload()">Refresh</button>
        <a class="server-link" href="/clients/new"><button type="button">+ Tambah Client</button></a>
      </div>
    </div>

    <% const groupNames = Object.keys(grouped); %>
    <% if (groupNames.length === 0) { %>
      <p class="meta">Belum ada client terdaftar. <a class="server-link" href="/clients/new">Tambah client pertama</a>.</p>
    <% } %>

    <% for (const groupName of groupNames) { %>
      <div class="group-label"><%= groupName %></div>
      <table>
        <thead>
          <tr>
            <th>Client</th>
            <th>Hostname</th>
            <th>Status</th>
            <th>RAM</th>
            <th>Disk</th>
            <th>Terakhir terlihat</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const c of grouped[groupName]) { %>
            <tr>
              <td><a class="server-link" href="/client/<%= c.id %>"><%= c.name %></a></td>
              <td class="meta"><%= c.hostname || '-' %></td>
              <td><span class="badge badge-<%= c.status %>"><%= c.status.toUpperCase() %></span></td>
              <td><%- include('partials/usage-bar', { percent: c.metric ? c.metric.memPercent : null }) %></td>
              <td><%- include('partials/usage-bar', { percent: c.metric ? c.metric.diskPercent : null }) %></td>
              <td class="meta"><%= c.lastSeenAt || 'belum pernah connect' %></td>
              <td><a class="server-link" href="/clients/<%= c.id %>/edit">edit</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </main>
  <script>
    const REFRESH_MS = 30000;
    let secondsLeft = REFRESH_MS / 1000;
    const indicator = document.getElementById('refresh-indicator');

    function tick() {
      secondsLeft -= 1;
      if (secondsLeft <= 0) {
        location.reload();
        return;
      }
      indicator.textContent = 'refresh otomatis dalam ' + secondsLeft + 's';
    }
    setInterval(tick, 1000);
  </script>
</body>
</html>
