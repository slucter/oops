<%- include('partials/layout-head', { title: 'Dashboard - sxops' }) %>
  <header>
    <a href="/">sxops</a>
    <div>
      <span class="meta"><%= username %></span>
      <form class="inline" method="post" action="/logout">
        <button type="submit">Keluar</button>
      </form>
    </div>
  </header>
  <main>
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h1>Status Server</h1>
      <a class="server-link" href="/servers/new"><button type="button">+ Tambah Server</button></a>
    </div>

    <% if (servers.length === 0) { %>
      <p class="meta">Belum ada server terdaftar. <a class="server-link" href="/servers/new">Tambah server pertama</a>.</p>
    <% } %>

    <%
      const groups = {};
      for (const s of servers) {
        groups[s.group] = groups[s.group] || [];
        groups[s.group].push(s);
      }
    %>
    <% for (const groupName of Object.keys(groups)) { %>
      <div class="group-label"><%= groupName %></div>
      <table>
        <thead>
          <tr>
            <th>Server</th>
            <th>Host</th>
            <th>Status</th>
            <th>Latency</th>
            <th>Cek terakhir</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const s of groups[groupName]) { %>
            <% const status = s.lastCheck ? s.lastCheck.status : 'unknown'; %>
            <tr>
              <td>
                <a class="server-link" href="/server/<%= s.id %>"><%= s.name %></a>
                <% if (s.viaName) { %><div class="meta">via <%= s.viaName %></div><% } %>
              </td>
              <td><%= s.host %>:<%= s.port %></td>
              <td><span class="badge badge-<%= status %>"><%= status.toUpperCase() %></span></td>
              <td><%= s.lastCheck && s.lastCheck.latency_ms != null ? s.lastCheck.latency_ms + ' ms' : '-' %></td>
              <td class="meta"><%= s.lastCheck ? s.lastCheck.checked_at : 'belum pernah dicek' %></td>
              <td><a class="server-link" href="/servers/<%= s.id %>/edit">edit</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
