<%- include('partials/layout-head', { title: 'Dashboard - sxops' }) %>
  <header>
    <a href="/">sxops</a>
    <div>
      <span class="meta"><%= username %></span>
      <form class="inline" method="post" action="/logout">
        <button type="submit">Keluar</button>
      </form>
    </div>
  </header>
  <main>
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h1>Status Server</h1>
      <div>
        <span class="meta" id="refresh-indicator"></span>
        <button type="button" onclick="location.reload()">Refresh</button>
        <a class="server-link" href="/servers/new"><button type="button">+ Tambah Server</button></a>
      </div>
    </div>

    <% if (servers.length === 0) { %>
      <p class="meta">Belum ada server terdaftar. <a class="server-link" href="/servers/new">Tambah server pertama</a>.</p>
    <% } %>

    <%
      const groups = {};
      for (const s of servers) {
        groups[s.group] = groups[s.group] || [];
        groups[s.group].push(s);
      }
    %>
    <% for (const groupName of Object.keys(groups)) { %>
      <div class="group-label"><%= groupName %></div>
      <table>
        <thead>
          <tr>
            <th>Server</th>
            <th>Host</th>
            <th>Status</th>
            <th>Latency</th>
            <th>RAM</th>
            <th>Disk</th>
            <th>Cek terakhir</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const s of groups[groupName]) { %>
            <% const status = s.lastCheck ? s.lastCheck.status : 'unknown'; %>
            <tr>
              <td>
                <span style="padding-left: <%= s.depth * 1.5 %>em;">
                  <% if (s.depth > 0) { %><span class="meta">&#8627; </span><% } %>
                  <a class="server-link" href="/server/<%= s.id %>"><%= s.name %></a>
                </span>
                <% if (s.viaName) { %><div class="meta" style="padding-left: <%= s.depth * 1.5 %>em;">via <%= s.viaName %></div><% } %>
              </td>
              <td><%= s.host %>:<%= s.port %></td>
              <td><span class="badge badge-<%= status %>"><%= status.toUpperCase() %></span></td>
              <td><%= s.lastCheck && s.lastCheck.latency_ms != null ? s.lastCheck.latency_ms + ' ms' : '-' %></td>
              <td><%- include('partials/usage-bar', { percent: s.resources ? s.resources.memPercent : null }) %></td>
              <td><%- include('partials/usage-bar', { percent: s.resources ? s.resources.diskPercent : null }) %></td>
              <td class="meta"><%= s.lastCheck ? s.lastCheck.checked_at : 'belum pernah dicek' %></td>
              <td><a class="server-link" href="/servers/<%= s.id %>/edit">edit</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </main>
  <script>
    const REFRESH_MS = 30000;
    let secondsLeft = REFRESH_MS / 1000;
    const indicator = document.getElementById('refresh-indicator');

    function tick() {
      secondsLeft -= 1;
      if (secondsLeft <= 0) {
        location.reload();
        return;
      }
      indicator.textContent = 'refresh otomatis dalam ' + secondsLeft + 's';
    }
    setInterval(tick, 1000);
  </script>
</body>
</html>
