<%- include('partials/layout-head', { title: (item ? 'Edit' : 'Add') + ' Client - Oops' }) %>
<%- include('partials/navbar', { username: username }) %>
  <main>
    <nav class="crumbs">
      <a href="/">&larr; Dashboard</a>
      <% if (item) { %>
        <span class="sep">/</span>
        <a href="/client/<%= item.id %>"><%= item.name %></a>
        <span class="sep">/</span>
        <span class="current">Edit</span>
      <% } else { %>
        <span class="sep">/</span>
        <span class="current">Add client</span>
      <% } %>
    </nav>

    <div class="page-head">
      <div>
        <h1><%= item ? 'Edit client' : 'Add client' %></h1>
        <div class="page-sub">
          <% if (item) { %>
            <%= item.name %> &middot; <span class="badge badge-<%= item.status %>"><%= item.status.toUpperCase() %></span>
          <% } else { %>
            Daftarkan client baru untuk mendapatkan command instalasi.
          <% } %>
        </div>
      </div>
    </div>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <div class="panel panel-pad form-narrow">
      <form method="post" action="<%= item ? '/clients/' + item.id + '/edit' : '/clients' %>">
        <div class="field">
          <label for="name">Nama client</label>
          <input type="text" id="name" name="name" required value="<%= item ? item.name : '' %>" placeholder="mis. Web Server Produksi" />
        </div>
        <div class="field">
          <label for="group_id">Grup</label>
          <select id="group_id" name="group_id">
            <option value="">— Belum dikelompokkan —</option>
            <% for (const g of groups) { %>
              <option value="<%= g.id %>" <%= item && item.groupId === g.id ? 'selected' : '' %>><%= g.name %></option>
            <% } %>
          </select>
        </div>
        <button type="submit" class="btn-primary"><%= item ? 'Save changes' : 'Create client' %></button>
      </form>
    </div>

    <% if (installCommand) { %>
      <h2>Install command</h2>
      <div class="panel panel-pad">
        <p class="meta" style="margin-top:0;">
          Jalankan satu baris ini di server yang mau dipantau — sebagai user biasa,
          tidak perlu root. Agent akan otomatis terhubung ke dashboard ini,
          dan tetap jalan lagi setelah proses mati maupun server di-reboot.
        </p>
        <div class="code-box" id="install-command"><%= installCommand %></div>
        <div style="margin-top:0.85rem; display:flex; gap:0.55rem; align-items:center;">
          <button type="button" class="btn-primary btn-sm" id="copy-btn" onclick="copyInstallCommand()">Copy command</button>
          <span class="meta" id="copy-status"></span>
        </div>
        <% if (item.status === 'pending') { %>
          <div class="notice" style="margin:1rem 0 0;">
            Status masih <strong>PENDING</strong> — menunggu client menjalankan command di atas untuk pertama kali.
          </div>
        <% } %>
      </div>
    <% } %>

    <% if (item) { %>
      <h2>Danger zone</h2>
      <div class="panel panel-pad">
        <div style="display:flex; justify-content:space-between; gap:1rem; align-items:center; flex-wrap:wrap;">
          <div>
            <strong style="font-size:0.85rem;">Regenerate token</strong>
            <div class="meta">Token lama langsung berhenti bekerja. Client yang sudah terpasang perlu diinstal ulang dengan command baru.</div>
          </div>
          <form method="post" action="/clients/<%= item.id %>/regenerate-token"
                onsubmit="return confirm('Token lama akan berhenti bekerja dan client yang sudah terpasang perlu diinstal ulang. Lanjutkan?');">
            <button type="submit" class="btn-ghost">Regenerate</button>
          </form>
        </div>

        <div style="height:1px; background:var(--line); margin:1rem 0;"></div>

        <div style="display:flex; justify-content:space-between; gap:1rem; align-items:center; flex-wrap:wrap;">
          <div>
            <strong style="font-size:0.85rem;">Remove client</strong>
            <div class="meta">Menghapus client beserta seluruh metrik dan riwayat statusnya. Tidak bisa dibatalkan.</div>
          </div>
          <form method="post" action="/clients/<%= item.id %>/delete"
                onsubmit="return confirm('Hapus client &quot;<%= item.name %>&quot;? Semua data metrik dan riwayatnya ikut terhapus permanen.');">
            <button type="submit" class="btn-danger">Remove client</button>
          </form>
        </div>
      </div>
    <% } %>
  </main>

  <script>
    function copyInstallCommand() {
      var text = document.getElementById('install-command').textContent;
      var status = document.getElementById('copy-status');
      navigator.clipboard.writeText(text).then(function () {
        status.textContent = '✔ tersalin';
        setTimeout(function () { status.textContent = ''; }, 2200);
      }).catch(function () {
        status.textContent = 'gagal menyalin — salin manual';
      });
    }
  </script>
<%- include('partials/layout-foot') %>
