<%- include('partials/layout-head', { title: item.name + ' - Oops' }) %>
<%- include('partials/navbar', { username: username }) %>
  <main>
    <nav class="crumbs">
      <a href="/">&larr; Dashboard</a>
      <span class="sep">/</span>
      <span class="current"><%= item.name %></span>
    </nav>

    <div class="page-head">
      <div>
        <h1><%= item.name %></h1>
        <div class="page-sub">
          <span id="live-hostname"><%= item.hostname || 'hostname belum diketahui' %></span>
          <% if (item.groupName) { %> &middot; <%= item.groupName %><% } %>
          &middot; last seen <span id="live-lastseen"><%= item.lastSeenAt || 'never' %></span>
        </div>
      </div>
      <div class="actions">
        <span class="live-dot" id="live-indicator" title="Data diperbarui otomatis"></span>
        <span class="badge badge-<%= item.status %>" id="live-status"><%= item.status.toUpperCase() %></span>
        <a class="btn btn-ghost" href="/clients/<%= item.id %>/edit">Edit</a>
      </div>
    </div>

    <div class="ip-row">
      <span class="ip-chip">
        <span class="ip-label">Internal</span>
        <span class="ip-value" id="live-private-ip"><%= item.privateIp || '—' %></span>
      </span>
      <span class="ip-chip">
        <span class="ip-label">Public</span>
        <span class="ip-value" id="live-public-ip"><%= item.publicIp || '—' %></span>
      </span>
    </div>

    <div id="stat-area">
    <% if (item.metric) { %>
      <div class="stat-grid">
        <div class="stat-card">
          <div class="label">Memory</div>
          <div class="value" id="live-mem-bar"><%- include('partials/usage-bar', { percent: item.metric.memPercent }) %></div>
          <div class="sub" id="live-mem-sub">
            <% if (item.metric.mem_total_mb != null) { %><%= (item.metric.mem_used_mb / 1024).toFixed(1) %> GB / <%= (item.metric.mem_total_mb / 1024).toFixed(1) %> GB<% } %>
          </div>
        </div>
        <div class="stat-card">
          <div class="label">Disk /</div>
          <div class="value" id="live-disk-bar"><%- include('partials/usage-bar', { percent: item.metric.diskPercent }) %></div>
          <div class="sub" id="live-disk-sub">
            <% if (item.metric.disk_total_gb != null) { %><%= item.metric.disk_used_gb %> GB / <%= item.metric.disk_total_gb %> GB<% } %>
          </div>
        </div>
        <div class="stat-card">
          <div class="label">CPU load</div>
          <div class="value" id="live-load"><%= item.metric.load_1m != null ? item.metric.load_1m : '—' %></div>
          <div class="sub" id="live-load-sub">
            5m <%= item.metric.load_5m != null ? item.metric.load_5m : '—' %>
            &middot; 15m <%= item.metric.load_15m != null ? item.metric.load_15m : '—' %>
          </div>
        </div>
        <div class="stat-card">
          <div class="label">Latency</div>
          <div class="value" id="live-latency"><%- include('partials/latency', { ms: item.status === 'up' ? item.lastLatencyMs : null }) %></div>
          <div class="sub" id="live-latency-sub">
            <% if (item.latencyStats) { %>
              avg <%= item.latencyStats.avg %>ms &middot; <%= item.latencyStats.min %>–<%= item.latencyStats.max %>ms
            <% } else { %>
              belum ada sampel
            <% } %>
          </div>
        </div>
        <div class="stat-card">
          <div class="label">Uptime</div>
          <div class="value" style="font-size:1rem;" id="live-uptime"><%= formatUptime(item.metric.uptime_seconds) %></div>
          <div class="sub" id="live-received">received <%= item.metric.received_at %></div>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state">
        <span class="big">No metrics yet</span>
        Belum ada data masuk dari client ini. Halaman ini akan memperbarui diri otomatis.
      </div>
    <% } %>
    </div>

    <h2>Memory &amp; CPU load</h2>
    <% if (item.metricHistory.length === 0) { %>
      <div class="empty-state">
        <span class="big">No history</span>
        Grafik akan terisi setelah beberapa siklus pengiriman metrik.
      </div>
    <% } else { %>
      <div class="chart-shell">
        <canvas id="resource-chart" height="78"></canvas>
      </div>
    <% } %>

    <h2>Latency</h2>
    <% const hasLatency = item.metricHistory.some(function (d) { return d.latency_ms != null; }); %>
    <% if (!hasLatency) { %>
      <div class="empty-state">
        <span class="big">No latency samples</span>
        Latency diukur lewat ping/pong WebSocket setiap 15 detik saat client terkoneksi.
      </div>
    <% } else { %>
      <div class="chart-shell">
        <canvas id="latency-chart" height="60"></canvas>
      </div>
    <% } %>

    <h2>Docker containers</h2>
    <div class="panel panel-pad">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.85rem; flex-wrap:wrap;">
        <span class="meta">docker ps -a &middot; diambil on-demand dari agent</span>
        <button type="button" class="btn-sm" onclick="refreshCommand('docker_ps', 'docker-output')">Refresh</button>
      </div>
      <div id="docker-output">
        <% if (item.dockerResult && item.dockerResult.output) { %>
          <div class="meta" style="margin-bottom:0.5rem;">Diambil: <%= item.dockerResult.requested_at %></div>
          <pre><%= item.dockerResult.output %></pre>
        <% } else if (item.dockerResult && item.dockerResult.error_message) { %>
          <div class="error" style="margin:0;"><%= item.dockerResult.error_message %></div>
        <% } else { %>
          <div class="meta">Belum ada data. Klik <strong>Refresh</strong> untuk mengambil sekarang.</div>
        <% } %>
      </div>
    </div>

    <h2>Listening ports</h2>
    <div class="panel panel-pad">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.85rem; flex-wrap:wrap;">
        <span class="meta">ss -tulnp &middot; diambil on-demand dari agent</span>
        <button type="button" class="btn-sm" onclick="refreshCommand('port_listen', 'port-output')">Refresh</button>
      </div>
      <div id="port-output">
        <% if (item.portResult && item.portResult.output) { %>
          <div class="meta" style="margin-bottom:0.5rem;">Diambil: <%= item.portResult.requested_at %></div>
          <pre><%= item.portResult.output %></pre>
        <% } else if (item.portResult && item.portResult.error_message) { %>
          <div class="error" style="margin:0;"><%= item.portResult.error_message %></div>
        <% } else { %>
          <div class="meta">Belum ada data. Klik <strong>Refresh</strong> untuk mengambil sekarang.</div>
        <% } %>
      </div>
    </div>

    <h2>Status history</h2>
    <% if (item.history.length === 0) { %>
      <div class="empty-state">
        <span class="big">No changes recorded</span>
        Perubahan status akan tercatat di sini.
      </div>
    <% } else { %>
      <div class="panel">
        <table>
          <thead>
            <tr><th style="width:210px;">Waktu</th><th style="width:130px;">Dari</th><th>Ke</th></tr>
          </thead>
          <tbody>
            <% for (const h of item.history) { %>
              <tr>
                <td class="meta num"><%= h.changed_at %></td>
                <td class="meta"><%= h.from_status || '—' %></td>
                <td><span class="badge badge-<%= h.to_status %>"><%= h.to_status.toUpperCase() %></span></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <script>
    async function refreshCommand(command, outputElId) {
      var el = document.getElementById(outputElId);
      el.innerHTML = '<div class="meta">&#10227; Menunggu balasan dari agent&hellip;</div>';
      try {
        var res = await fetch('/clients/<%= item.id %>/command/' + command, { method: 'POST' });
        var data = await res.json();
        if (!res.ok) {
          el.innerHTML = '<div class="error" style="margin:0;">' + escapeHtml(data.error || 'Gagal.') + '</div>';
          return;
        }
        if (data.errorMessage) {
          el.innerHTML = '<div class="error" style="margin:0;">' + escapeHtml(data.errorMessage) + '</div>';
        } else {
          el.innerHTML = '<pre>' + escapeHtml(data.output || '') + '</pre>';
        }
      } catch (err) {
        el.innerHTML = '<div class="error" style="margin:0;">' + escapeHtml(err.message) + '</div>';
      }
    }

    function escapeHtml(str) {
      var div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }
  </script>

  <% if (item.metricHistory.length > 0) { %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
      (function () {
        var resourceData = <%- JSON.stringify(item.metricHistory) %>;
        var labels = resourceData.map(function (d) { return d.received_at; });
        var memPercent = resourceData.map(function (d) {
          return d.mem_total_mb ? Math.round((d.mem_used_mb / d.mem_total_mb) * 100) : null;
        });
        var load = resourceData.map(function (d) { return d.load_1m; });

        var gridColor = 'rgba(61, 216, 138, 0.08)';
        var borderColor = 'rgba(61, 216, 138, 0.16)';
        var tickColor = '#7d9489';
        var monoFont = { family: 'JetBrains Mono, monospace', size: 10 };

        var ctx = document.getElementById('resource-chart').getContext('2d');
        var memFill = ctx.createLinearGradient(0, 0, 0, 260);
        memFill.addColorStop(0, 'rgba(61, 216, 138, 0.22)');
        memFill.addColorStop(1, 'rgba(61, 216, 138, 0)');

        window.__resourceChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [
              {
                label: 'MEMORY %',
                data: memPercent,
                borderColor: '#3dd88a',
                backgroundColor: memFill,
                borderWidth: 2,
                yAxisID: 'yPercent',
                tension: 0.32,
                pointRadius: 0,
                pointHoverRadius: 4,
                pointHoverBackgroundColor: '#3dd88a',
                pointHoverBorderColor: '#071009',
                fill: true,
              },
              {
                label: 'CPU LOAD 1M',
                data: load,
                borderColor: '#dbb352',
                backgroundColor: 'transparent',
                borderWidth: 2,
                borderDash: [4, 3],
                yAxisID: 'yLoad',
                tension: 0.32,
                pointRadius: 0,
                pointHoverRadius: 4,
                pointHoverBackgroundColor: '#dbb352',
                pointHoverBorderColor: '#071009',
              },
            ],
          },
          options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            scales: {
              x: {
                ticks: { color: tickColor, maxTicksLimit: 7, font: monoFont },
                grid: { color: gridColor },
                border: { color: borderColor },
              },
              yPercent: {
                type: 'linear', position: 'left', min: 0, max: 100,
                ticks: { color: tickColor, font: monoFont, callback: function (v) { return v + '%'; } },
                grid: { color: gridColor },
                border: { color: borderColor },
              },
              yLoad: {
                type: 'linear', position: 'right', beginAtZero: true,
                ticks: { color: '#9a7d3a', font: monoFont },
                grid: { drawOnChartArea: false },
                border: { color: borderColor },
              },
            },
            plugins: {
              legend: {
                labels: {
                  color: '#cfe3d8',
                  boxWidth: 12,
                  boxHeight: 2,
                  usePointStyle: false,
                  font: { family: 'JetBrains Mono, monospace', size: 10 },
                },
              },
              tooltip: {
                backgroundColor: '#0b1310',
                borderColor: 'rgba(61,216,138,.34)',
                borderWidth: 1,
                titleColor: '#3dd88a',
                bodyColor: '#cfe3d8',
                titleFont: { family: 'JetBrains Mono, monospace', size: 11 },
                bodyFont: { family: 'JetBrains Mono, monospace', size: 11 },
                padding: 10,
                displayColors: true,
                cornerRadius: 4,
              },
            },
          },
        });

        // Grafik latency terpisah — skalanya (ms) jauh beda dari RAM %/load,
        // jadi digabung ke chart di atas malah bikin dua-duanya sulit dibaca.
        var latencyCanvas = document.getElementById('latency-chart');
        if (latencyCanvas) {
          var latCtx = latencyCanvas.getContext('2d');
          var latFill = latCtx.createLinearGradient(0, 0, 0, 200);
          latFill.addColorStop(0, 'rgba(86, 184, 212, 0.24)');
          latFill.addColorStop(1, 'rgba(86, 184, 212, 0)');

          window.__latencyChart = new Chart(latCtx, {
            type: 'line',
            data: {
              labels: labels,
              datasets: [{
                label: 'LATENCY (MS)',
                data: resourceData.map(function (d) { return d.latency_ms; }),
                borderColor: '#56b8d4',
                backgroundColor: latFill,
                borderWidth: 2,
                tension: 0.32,
                pointRadius: 0,
                pointHoverRadius: 4,
                pointHoverBackgroundColor: '#56b8d4',
                pointHoverBorderColor: '#071009',
                fill: true,
                spanGaps: true,
              }],
            },
            options: {
              responsive: true,
              interaction: { mode: 'index', intersect: false },
              scales: {
                x: {
                  ticks: { color: tickColor, maxTicksLimit: 7, font: monoFont },
                  grid: { color: gridColor },
                  border: { color: borderColor },
                },
                y: {
                  beginAtZero: true,
                  ticks: { color: '#4a8ba1', font: monoFont, callback: function (v) { return v + 'ms'; } },
                  grid: { color: gridColor },
                  border: { color: borderColor },
                },
              },
              plugins: {
                legend: {
                  labels: {
                    color: '#cfe3d8', boxWidth: 12, boxHeight: 2,
                    font: { family: 'JetBrains Mono, monospace', size: 10 },
                  },
                },
                tooltip: {
                  backgroundColor: '#0b1310',
                  borderColor: 'rgba(86,184,212,.4)',
                  borderWidth: 1,
                  titleColor: '#56b8d4',
                  bodyColor: '#cfe3d8',
                  titleFont: { family: 'JetBrains Mono, monospace', size: 11 },
                  bodyFont: { family: 'JetBrains Mono, monospace', size: 11 },
                  padding: 10,
                  cornerRadius: 4,
                },
              },
            },
          });
        }
      })();
    </script>
  <% } %>

  <script>
    // Realtime halaman detail: ambil data terbaru berkala dan perbarui angka
    // di tempat, tanpa reload penuh — supaya grafik tidak berkedip dan posisi
    // scroll pengguna tidak hilang.
    (function () {
      var LIVE_INTERVAL_MS = 5000;
      var CLIENT_ID = <%= item.id %>;
      var dot = document.getElementById('live-indicator');

      function setText(id, value) {
        var el = document.getElementById(id);
        if (el && value != null) el.textContent = value;
      }

      function usageBarHtml(percent) {
        if (percent == null) return '<span class="meta">—</span>';
        var cls = percent >= 90 ? 'usage-crit' : percent >= 75 ? 'usage-warn' : 'usage-ok';
        var w = Math.min(percent, 100);
        return '<span class="usage-cell"><span class="usage-bar">' +
          '<span class="usage-bar-fill ' + cls + '" style="width:' + w + '%;"></span></span>' +
          '<span class="usage-label">' + percent + '%</span></span>';
      }

      function latencyHtml(ms) {
        if (ms == null) return '<span class="meta">—</span>';
        var cls = ms < 100 ? 'lat-good' : ms < 300 ? 'lat-ok' : 'lat-bad';
        return '<span class="latency ' + cls + '">' + ms + '<span class="unit">ms</span></span>';
      }

      function setHtml(id, html) {
        var el = document.getElementById(id);
        if (el) el.innerHTML = html;
      }

      async function tick() {
        try {
          var res = await fetch('/client/' + CLIENT_ID + '/live', { headers: { 'Accept': 'application/json' } });
          if (!res.ok) return;
          var d = await res.json();

          var badge = document.getElementById('live-status');
          if (badge && d.status) {
            badge.textContent = d.status.toUpperCase();
            badge.className = 'badge badge-' + d.status;
          }
          setText('live-hostname', d.hostname || 'hostname belum diketahui');
          setText('live-lastseen', d.lastSeenAt || 'never');
          setText('live-private-ip', d.privateIp || '—');
          setText('live-public-ip', d.publicIp || '—');

          setHtml('live-latency', latencyHtml(d.status === 'up' ? d.lastLatencyMs : null));
          if (d.latencyStats) {
            setText('live-latency-sub', 'avg ' + d.latencyStats.avg + 'ms · ' + d.latencyStats.min + '–' + d.latencyStats.max + 'ms');
          }

          if (d.metric) {
            setHtml('live-mem-bar', usageBarHtml(d.metric.memPercent));
            if (d.metric.mem_total_mb != null) {
              setText('live-mem-sub', (d.metric.mem_used_mb / 1024).toFixed(1) + ' GB / ' + (d.metric.mem_total_mb / 1024).toFixed(1) + ' GB');
            }
            setHtml('live-disk-bar', usageBarHtml(d.metric.diskPercent));
            if (d.metric.disk_total_gb != null) {
              setText('live-disk-sub', d.metric.disk_used_gb + ' GB / ' + d.metric.disk_total_gb + ' GB');
            }
            setText('live-load', d.metric.load_1m != null ? d.metric.load_1m : '—');
            setText('live-load-sub', '5m ' + (d.metric.load_5m != null ? d.metric.load_5m : '—') +
              ' · 15m ' + (d.metric.load_15m != null ? d.metric.load_15m : '—'));
            setText('live-uptime', d.uptimeText);
            setText('live-received', 'received ' + d.metric.received_at);
          }

          if (window.__resourceChart && d.metricHistory) {
            var c = window.__resourceChart;
            c.data.labels = d.metricHistory.map(function (x) { return x.received_at; });
            c.data.datasets[0].data = d.metricHistory.map(function (x) {
              return x.mem_total_mb ? Math.round((x.mem_used_mb / x.mem_total_mb) * 100) : null;
            });
            c.data.datasets[1].data = d.metricHistory.map(function (x) { return x.load_1m; });
            c.update('none');
          }
          if (window.__latencyChart && d.metricHistory) {
            var lc = window.__latencyChart;
            lc.data.labels = d.metricHistory.map(function (x) { return x.received_at; });
            lc.data.datasets[0].data = d.metricHistory.map(function (x) { return x.latency_ms; });
            lc.update('none');
          }

          if (dot) { dot.style.background = 'var(--accent)'; dot.title = 'Live — diperbarui otomatis'; }
        } catch (e) {
          if (dot) { dot.style.background = 'var(--danger)'; dot.title = 'Gagal mengambil data terbaru'; }
        }
      }

      setInterval(tick, LIVE_INTERVAL_MS);
    })();
  </script>
<%- include('partials/layout-foot') %>
