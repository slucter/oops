<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Oops' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
      /* Palet hijau sengaja diturunkan kontras & saturasinya (dari #3dd88a
         neon ke #3dd88a yang lebih teduh) supaya nyaman dipandang lama —
         diminta pemilik projek karena versi neon bikin sakit mata. */
      --bg: #070b09;
      --grid: rgba(61, 216, 138, 0.04);
      --grid-strong: rgba(61, 216, 138, 0.075);
      --accent: #3dd88a;
      --accent-soft: #5ee5a2;
      --accent-dim: #2a9c63;
      --accent-glow: rgba(61, 216, 138, 0.22);
      --text: #cfe3d8;
      --text-dim: #7d9489;
      --text-faint: #4e6259;
      --panel: rgba(12, 20, 16, 0.72);
      --panel-solid: #0b1310;
      --panel-head: rgba(61, 216, 138, 0.03);
      --line: rgba(61, 216, 138, 0.13);
      --line-strong: rgba(61, 216, 138, 0.26);
      --danger: #e8636f;
      --danger-dim: rgba(232, 99, 111, 0.35);
      --warn: #dbb352;
      --info: #56b8d4;
      --r: 10px;
    }

    * { box-sizing: border-box; }
    html, body { min-height: 100%; }

    body {
      margin: 0;
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--text);
      background: var(--bg);
      position: relative;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Grid hijau: pekat di bawah, memudar hilang di 70% tinggi ke atas. */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px),
        linear-gradient(var(--grid-strong) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-strong) 1px, transparent 1px);
      background-size: 26px 26px, 26px 26px, 156px 156px, 156px 156px;
      -webkit-mask-image: linear-gradient(to top, #000 0%, rgba(0,0,0,.8) 26%, rgba(0,0,0,.3) 50%, transparent 70%);
      mask-image: linear-gradient(to top, #000 0%, rgba(0,0,0,.8) 26%, rgba(0,0,0,.3) 50%, transparent 70%);
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(130% 60% at 50% 115%, rgba(61,216,138,.14) 0%, rgba(61,216,138,.04) 45%, transparent 72%),
        linear-gradient(to top, rgba(0,0,0,.6) 0%, transparent 70%);
    }

    header, main, .auth-wrap { position: relative; z-index: 1; }

    /* ================= NAVBAR =================
       Bentuk angular: sudut kiri-atas & kanan-bawah terpotong,
       plus garis aksen tipis di bawah. */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.65rem 1.4rem;
      background: linear-gradient(180deg, rgba(6,14,10,.96), rgba(5,11,8,.86));
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 10px 34px -26px var(--accent-glow);
    }

    .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; }
    .brand-badge {
      width: 30px; height: 30px;
      display: grid; place-items: center;
      background: var(--accent);
      color: #03130b;
      font-weight: 700;
      font-size: 0.9rem;
      clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
      box-shadow: 0 0 18px -4px var(--accent-glow);
    }
    .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
    .brand-text .name {
      color: var(--text);
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.12em;
    }
    .brand-text .name b { color: var(--accent); font-weight: 700; }
    .brand-text .sub {
      color: var(--text-faint);
      font-size: 0.58rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .nav-right { display: flex; align-items: center; gap: 0.5rem; }

    /* Item navbar: kapsul angular (sudut kiri-atas + kanan-bawah dipotong) */
    .nav-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font: inherit;
      font-size: 0.76rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-dim);
      background: rgba(61, 216, 138, 0.03);
      border: 1px solid var(--line);
      padding: 0.46rem 0.85rem;
      cursor: pointer;
      text-decoration: none;
      clip-path: polygon(9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%, 0 9px);
      transition: color .16s, background .16s, border-color .16s, box-shadow .16s;
    }
    .nav-btn:hover,
    .dropdown.open > .nav-btn {
      color: var(--accent);
      background: rgba(61, 216, 138, 0.1);
      border-color: var(--line-strong);
      box-shadow: 0 0 20px -8px var(--accent-glow);
    }
    .nav-btn .caret { font-size: 0.55rem; opacity: .75; transition: transform .18s; }
    .dropdown.open > .nav-btn .caret { transform: rotate(180deg); }

    .nav-btn.avatar-btn { padding: 0.32rem 0.7rem 0.32rem 0.32rem; gap: 0.55rem; }
    .avatar {
      width: 26px; height: 26px;
      flex: none;
      display: grid; place-items: center;
      background: rgba(61, 216, 138, 0.14);
      border: 1px solid var(--line-strong);
      color: var(--accent);
      font-weight: 700;
      font-size: 0.72rem;
      clip-path: polygon(7px 0, 100% 0, 100% calc(100% - 7px), calc(100% - 7px) 100%, 0 100%, 0 7px);
    }

    /* ================= DROPDOWN ================= */
    .dropdown { position: relative; }
    .dropdown-menu {
      position: absolute;
      right: 0;
      top: calc(100% + 0.55rem);
      min-width: 224px;
      background: var(--panel-solid);
      border: 1px solid var(--line-strong);
      border-radius: 4px;
      padding: 0.35rem;
      display: none;
      z-index: 60;
      box-shadow: 0 24px 50px -24px #000, 0 0 40px -28px var(--accent-glow);
      clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
    }
    .dropdown.open .dropdown-menu { display: block; animation: ddIn .13s ease-out; }
    @keyframes ddIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
    .dropdown-menu.left { right: auto; left: 0; }

    .dropdown-item {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      width: 100%;
      padding: 0.5rem 0.65rem;
      color: var(--text);
      text-decoration: none;
      font: inherit;
      font-size: 0.8rem;
      background: transparent;
      border: 0;
      text-align: left;
      cursor: pointer;
      border-radius: 3px;
      transition: background .13s, color .13s;
    }
    .dropdown-item .ico { color: var(--accent-dim); font-size: 0.75rem; width: 1rem; text-align: center; }
    .dropdown-item:hover { background: rgba(61, 216, 138, 0.1); color: var(--accent); }
    .dropdown-item:hover .ico { color: var(--accent); }
    .dropdown-item.danger { color: #ffb3bb; }
    .dropdown-item.danger .ico { color: var(--danger); }
    .dropdown-item.danger:hover { background: rgba(232, 99, 111, 0.13); color: var(--danger); }
    .dropdown-divider { height: 1px; background: var(--line); margin: 0.3rem 0.15rem; }

    .profile-head {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.6rem 0.65rem 0.7rem;
      border-bottom: 1px solid var(--line);
      margin-bottom: 0.3rem;
    }
    .profile-head .avatar { width: 34px; height: 34px; font-size: 0.85rem; }
    .profile-head .who { min-width: 0; }
    .profile-head .who strong { display: block; font-size: 0.85rem; letter-spacing: 0.04em; color: var(--text); }
    .profile-head .who span {
      display: inline-flex; align-items: center; gap: 0.3rem;
      font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-dim);
    }
    .dot-live { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 6px -1px var(--accent); }

    /* ================= LAYOUT ================= */
    /* Lebar dibatasi supaya baris teks panjang tidak melelahkan dibaca, tapi
       cukup longgar untuk tabel dashboard yang punya 10 kolom — di 1180px
       kolom hostname dan last-seen terbungkus jadi tiga baris. */
    main { padding: 1.7rem 1.8rem 4rem; max-width: 1560px; margin: 0 auto; }

    h1 {
      font-size: 1.18rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin: 0;
      color: var(--text);
    }
    h2 {
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 2rem 0 0.7rem;
      display: flex; align-items: center; gap: 0.75rem;
      font-weight: 600;
    }
    h2::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--line), transparent); }

    /* Breadcrumb: jalur balik yang eksplisit di bawah navbar, supaya
       "kembali ke dashboard" tidak perlu dicari-cari. */
    .crumbs {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.72rem;
      margin-bottom: 1rem;
      color: var(--text-faint);
      flex-wrap: wrap;
    }
    .crumbs a {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--accent);
      text-decoration: none;
      padding: 0.28rem 0.6rem;
      border: 1px solid var(--line);
      background: rgba(61, 216, 138, 0.05);
      clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
      transition: background .14s, border-color .14s;
    }
    .crumbs a:hover { background: rgba(61, 216, 138, 0.12); border-color: var(--line-strong); }
    .crumbs .sep { opacity: 0.6; }
    .crumbs .current { color: var(--text-dim); }

    .page-head {
      display: flex; justify-content: space-between; align-items: center;
      gap: 1rem; flex-wrap: wrap; margin-bottom: 1.1rem;
    }
    .page-head .actions { display: flex; align-items: center; gap: 0.55rem; }
    .page-sub { color: var(--text-dim); font-size: 0.76rem; margin-top: 0.15rem; }

    /* ================= PANEL / TABEL ================= */
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--r);
      overflow: hidden;
    }
    .panel + .panel { margin-top: 1rem; }
    .panel-pad { padding: 1.1rem 1.2rem; }

    table { width: 100%; border-collapse: collapse; }
    thead th {
      text-align: left;
      padding: 0.6rem 1rem;
      color: var(--text-dim);
      font-weight: 500;
      font-size: 0.64rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      background: var(--panel-head);
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    tbody td { padding: 0.72rem 1rem; border-bottom: 1px solid rgba(61,216,138,.07); vertical-align: middle; }
    tbody tr { transition: background .14s; }
    tbody tr:hover { background: rgba(61,216,138,.04); }
    tbody tr:last-child td { border-bottom: 0; }
    td.cell-name { font-weight: 600; color: var(--text); }
    td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }

    /* Kolom yang isinya satu satuan utuh — hostname, IP, waktu, tombol aksi —
       tidak boleh dipecah jadi beberapa baris. "2026-09-30 16:53:01" yang
       terbelah tiga baris membuat tiap baris tabel jadi setinggi tiga baris
       dan justru memakan lebar, bukan menghemat. Nama client sengaja TIDAK
       ikut aturan ini: nama panjang memang lebih baik membungkus daripada
       mendorong kolom lain keluar layar. */
    td.cell-host, td.cell-time, td.cell-ip, td.cell-actions { white-space: nowrap; }
    td.cell-host { max-width: 190px; overflow: hidden; text-overflow: ellipsis; }

    .group-label {
      color: var(--accent);
      font-size: 0.66rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 1.7rem 0 0.55rem;
      display: flex; align-items: center; gap: 0.6rem;
      font-weight: 600;
    }
    .group-label::before { content: '▚'; opacity: .65; }
    .group-label::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--line), transparent); }
    .group-label .count { color: var(--text-faint); letter-spacing: .1em; }

    /* ================= BADGE ================= */
    .badge {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.14rem 0.55rem;
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      border: 1px solid;
      border-radius: 999px;
      white-space: nowrap;
    }
    .badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .badge-up { background: rgba(61,216,138,.09); color: var(--accent); border-color: rgba(61,216,138,.4); box-shadow: 0 0 14px -6px var(--accent-glow); }
    .badge-up::before { box-shadow: none; }
    .badge-down { background: rgba(232,99,111,.09); color: var(--danger); border-color: var(--danger-dim); }
    .badge-unreachable { background: rgba(219,179,82,.09); color: var(--warn); border-color: rgba(219,179,82,.38); }
    .badge-unknown { background: rgba(108,138,123,.1); color: var(--text-dim); border-color: rgba(108,138,123,.3); }
    .badge-pending { background: rgba(86,184,212,.09); color: var(--info); border-color: rgba(86,184,212,.35); }

    /* ================= BUTTON =================
       Bentuk angular HUD: dua sudut berlawanan terpotong. */
    button, .btn {
      position: relative;
      font: inherit;
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      padding: 0.5rem 0.95rem;
      border: 1px solid var(--line-strong);
      background: rgba(61, 216, 138, 0.05);
      color: var(--accent);
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      white-space: nowrap;
      clip-path: polygon(9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%, 0 9px);
      transition: background .15s, color .15s, border-color .15s, box-shadow .15s, transform .08s;
    }
    button:hover, .btn:hover {
      background: rgba(61, 216, 138, 0.14);
      border-color: var(--accent);
      box-shadow: 0 0 24px -9px var(--accent-glow);
    }
    button:active, .btn:active { transform: translateY(1px); }
    button:focus-visible, .btn:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }

    .btn-primary {
      background: var(--accent);
      color: #02150c;
      border-color: var(--accent);
      font-weight: 700;
      box-shadow: 0 0 26px -10px var(--accent-glow);
    }
    .btn-primary:hover { background: var(--accent-soft); border-color: var(--accent-soft); color: #02150c; box-shadow: 0 0 30px -6px var(--accent-glow); }

    .btn-ghost { background: transparent; color: var(--text-dim); border-color: var(--line); }
    .btn-ghost:hover { color: var(--accent); background: rgba(61,216,138,.08); border-color: var(--line-strong); }

    .btn-danger { background: rgba(232,99,111,.07); color: var(--danger); border-color: var(--danger-dim); }
    .btn-danger:hover { background: rgba(232,99,111,.16); border-color: var(--danger); box-shadow: 0 0 24px -9px rgba(232,99,111,.55); }

    .btn-sm {
      padding: 0.3rem 0.62rem;
      font-size: 0.68rem;
      clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
    }
    .btn-block { width: 100%; }

    /* ================= FORM ================= */
    label {
      display: block;
      font-size: 0.64rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 0.4rem;
      font-weight: 500;
    }
    input[type="text"], input[type="password"], select {
      font: inherit;
      font-size: 0.84rem;
      width: 100%;
      padding: 0.6rem 0.75rem;
      background: rgba(0,0,0,.5);
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--text);
      outline: none;
      transition: border-color .15s, box-shadow .15s, background .15s;
    }
    input[type="text"]:focus, input[type="password"]:focus, select:focus {
      border-color: var(--accent);
      background: rgba(0,0,0,.66);
      box-shadow: 0 0 0 3px rgba(61,216,138,.09);
    }
    input::placeholder { color: var(--text-faint); }
    select option { background: var(--panel-solid); color: var(--text); }
    .field { margin-bottom: 1rem; }
    .form-narrow { max-width: 470px; }
    form.inline { display: inline; }
    .form-row { display: flex; gap: 0.6rem; align-items: flex-end; }
    .form-row .field { flex: 1; margin-bottom: 0; }

    /* ================= LOGIN ================= */
    .auth-wrap { min-height: 100vh; display: grid; place-items: center; padding: 2rem 1.25rem; }
    .auth-card {
      width: 100%;
      max-width: 352px;
      background: linear-gradient(180deg, rgba(8,19,14,.9), rgba(5,12,9,.82));
      border: 1px solid var(--line-strong);
      border-radius: 12px;
      backdrop-filter: blur(8px);
      padding: 2rem 1.75rem 1.6rem;
      box-shadow: 0 40px 80px -50px #000, 0 0 70px -46px var(--accent-glow);
    }
    .auth-brand { text-align: center; margin-bottom: 1.7rem; }
    .auth-brand .logo-mark {
      width: 46px; height: 46px;
      margin: 0 auto 0.85rem;
      display: grid; place-items: center;
      background: var(--accent);
      color: #02150c;
      font-size: 1.25rem;
      font-weight: 700;
      clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
      box-shadow: 0 0 34px -8px var(--accent-glow);
    }
    .auth-brand .logo {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: 0.26em;
      color: var(--text);
      line-height: 1.1;
      text-indent: 0.26em;
    }
    .auth-brand .expand {
      margin-top: 0.55rem;
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--accent);
      line-height: 1.8;
      opacity: 0.85;
    }
    .auth-brand .expand b { color: var(--accent-soft); font-weight: 700; }
    .auth-foot {
      margin-top: 1.25rem; padding-top: 1rem;
      border-top: 1px solid var(--line);
      text-align: center;
      font-size: 0.58rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-faint);
    }

    /* ================= UTIL ================= */
    .meta { color: var(--text-dim); font-size: 0.74rem; }
    .muted { color: var(--text-faint); }

    .error {
      color: #ffb3bb;
      background: rgba(232,99,111,.08);
      border: 1px solid var(--danger-dim);
      border-left: 3px solid var(--danger);
      border-radius: 4px;
      padding: 0.6rem 0.8rem;
      font-size: 0.78rem;
      margin-bottom: 1rem;
    }

    .notice {
      color: #cfe9db;
      background: rgba(61,216,138,.05);
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      border-radius: 4px;
      padding: 0.65rem 0.85rem;
      font-size: 0.78rem;
      margin-bottom: 1rem;
    }

    .code-box {
      background: rgba(0,0,0,.6);
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      border-radius: 4px;
      padding: 0.85rem 0.95rem;
      font-size: 0.78rem;
      color: var(--accent);
      word-break: break-all;
      white-space: pre-wrap;
      line-height: 1.75;
    }

    pre {
      background: rgba(0,0,0,.6);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.9rem 1rem;
      overflow-x: auto;
      font-size: 0.73rem;
      line-height: 1.65;
      color: #a9e6c6;
      margin: 0;
    }

    a.server-link {
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: color .14s, border-color .14s, text-shadow .14s;
    }
    a.server-link:hover { color: var(--accent); border-bottom-color: var(--line-strong); text-shadow: none; }

    .empty-state {
      border: 1px dashed var(--line-strong);
      border-radius: var(--r);
      padding: 2.6rem 1rem;
      text-align: center;
      color: var(--text-dim);
      font-size: 0.82rem;
      background: rgba(61,216,138,.02);
    }
    .empty-state .big {
      display: block; color: var(--accent);
      letter-spacing: .2em; margin-bottom: 0.45rem;
      font-size: 0.75rem; text-transform: uppercase; font-weight: 600;
    }

    /* ================= USAGE BAR ================= */
    .usage-cell { display: inline-flex; align-items: center; }
    .usage-bar {
      width: 66px; height: 5px;
      background: rgba(61,216,138,.09);
      border: 1px solid rgba(61,216,138,.16);
      border-radius: 3px;
      overflow: hidden;
      display: inline-block;
      vertical-align: middle;
    }
    .usage-bar-fill { display: block; height: 100%; }
    .usage-ok { background: var(--accent); box-shadow: 0 0 9px var(--accent-glow); }
    .usage-warn { background: var(--warn); box-shadow: 0 0 9px rgba(219,179,82,.45); }
    .usage-crit { background: var(--danger); box-shadow: 0 0 9px rgba(232,99,111,.5); }
    .usage-label { font-size: 0.7rem; color: var(--text-dim); margin-left: 0.45rem; vertical-align: middle; font-variant-numeric: tabular-nums; }

    /* ================= SETTINGS FORM ================= */
    .settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0.9rem 1.1rem; }
    .settings-grid .field { margin-bottom: 0; }
    .field-hint { color: var(--text-faint); font-size: 0.66rem; margin-top: 0.3rem; line-height: 1.5; }
    .check-row { display: flex; flex-direction: column; gap: 0.65rem; }
    .check { display: inline-flex; align-items: center; gap: 0.55rem; cursor: pointer; margin-bottom: 0; text-transform: none; letter-spacing: 0; font-size: 0.82rem; color: var(--text); }
    .check input[type="checkbox"] {
      appearance: none;
      width: 16px; height: 16px;
      flex: none;
      border: 1px solid var(--line-strong);
      background: rgba(0,0,0,.5);
      cursor: pointer;
      position: relative;
      clip-path: polygon(4px 0, 100% 0, 100% calc(100% - 4px), calc(100% - 4px) 100%, 0 100%, 0 4px);
    }
    .check input[type="checkbox"]:checked { background: var(--accent); border-color: var(--accent); }
    .check input[type="checkbox"]:checked::after {
      content: '✓';
      position: absolute; inset: 0;
      display: grid; place-items: center;
      color: #071009; font-size: 11px; font-weight: 700;
    }
    input[type="password"] {
      font: inherit; font-size: 0.84rem; width: 100%;
      padding: 0.6rem 0.75rem;
      background: rgba(0,0,0,.5);
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--text);
      outline: none;
      transition: border-color .15s, box-shadow .15s, background .15s;
    }
    input[type="password"]:focus {
      border-color: var(--accent);
      background: rgba(0,0,0,.66);
      box-shadow: 0 0 0 3px rgba(61,216,138,.09);
    }
    code {
      background: rgba(61,216,138,.08);
      border: 1px solid var(--line);
      padding: 0.05rem 0.3rem;
      border-radius: 3px;
      font-size: 0.92em;
      color: var(--accent);
    }

    /* ================= PUSH ================= */
    .push-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      padding: 0.9rem 1rem;
      border: 1px solid var(--line);
      border-radius: 4px;
      background: rgba(0,0,0,.25);
    }
    .push-status { font-size: 0.82rem; display: flex; align-items: center; gap: 0.45rem; }
    .push-status::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex: none; }
    .push-good { color: var(--accent); }
    .push-dim { color: var(--text-dim); }
    .push-bad { color: var(--danger); }

    /* ================= ALERT ================= */
    .alert-dot {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.1rem 0.45rem;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      border: 1px solid;
      border-radius: 999px;
      white-space: nowrap;
      cursor: help;
    }
    .alert-critical { background: rgba(232,99,111,.12); color: var(--danger); border-color: var(--danger-dim); }
    .alert-warning { background: rgba(219,179,82,.12); color: var(--warn); border-color: rgba(219,179,82,.35); }
    .alert-ok { color: var(--text-faint); border-color: transparent; background: transparent; }

    .alert-list { display: flex; flex-direction: column; gap: 0.55rem; }
    .alert-item {
      display: flex;
      align-items: flex-start;
      gap: 0.7rem;
      padding: 0.7rem 0.85rem;
      border: 1px solid var(--line);
      border-left-width: 3px;
      border-radius: 4px;
      background: rgba(0,0,0,.25);
    }
    .alert-item.sev-critical { border-left-color: var(--danger); }
    .alert-item.sev-warning { border-left-color: var(--warn); }
    .alert-item.sev-info { border-left-color: var(--info); }
    .alert-item .body { flex: 1; min-width: 0; }
    .alert-item .msg { color: var(--text); font-size: 0.82rem; }
    .alert-item .sub { color: var(--text-dim); font-size: 0.7rem; margin-top: 0.2rem; }
    .alert-item .when { color: var(--text-faint); font-size: 0.68rem; white-space: nowrap; font-variant-numeric: tabular-nums; }

    .banner-alert {
      display: flex; align-items: center; gap: 0.7rem;
      padding: 0.7rem 0.95rem;
      border: 1px solid var(--danger-dim);
      border-left: 3px solid var(--danger);
      background: rgba(232,99,111,.08);
      border-radius: 4px;
      margin-bottom: 1.1rem;
      font-size: 0.8rem;
      color: #f0c2c7;
    }
    .banner-alert .count { font-weight: 700; color: var(--danger); }

    /* ================= SHARE ================= */
    .share-badge {
      display: inline-flex; align-items: center; gap: .35rem;
      padding: .25rem .6rem;
      font-size: .64rem; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--info);
      border: 1px solid rgba(86,184,212,.32);
      background: rgba(86,184,212,.1);
      border-radius: 999px;
      white-space: nowrap;
    }
    .share-exp {
      color: var(--text-faint); font-size: .68rem;
      margin-left: .6rem; white-space: nowrap;
    }
    .share-label-bar {
      background: var(--panel-head);
      border-bottom: 1px solid var(--line);
      padding: .45rem 1.8rem;
      color: var(--text-dim); font-size: .74rem;
      letter-spacing: .04em;
    }

    .btn-icon { padding-left: .5rem; padding-right: .5rem; font-size: .8rem; line-height: 1; }

    .share-url-row { display: flex; gap: .5rem; flex-wrap: wrap; }
    .share-url-row input {
      flex: 1; min-width: 220px;
      font-size: .74rem;
      font-family: inherit;
    }

    .share-grup { border: 1px solid var(--line); border-radius: 4px; margin-bottom: .7rem; }
    .share-grup-head {
      display: flex; align-items: center; gap: .6rem;
      padding: .5rem .8rem;
      background: var(--panel-head);
      border-bottom: 1px solid var(--line);
    }
    .share-grup-head .count { margin-left: auto; color: var(--text-faint); font-size: .7rem; }
    .share-grup-body {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: .3rem .9rem; padding: .7rem .8rem;
    }

    .share-tag {
      font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      padding: .1rem .45rem; border-radius: 999px; border: 1px solid;
      white-space: nowrap;
    }
    .share-tag.tanpa-batas { color: var(--warn); border-color: rgba(219,179,82,.35); background: rgba(219,179,82,.1); }
    .share-tag.habis { color: var(--text-faint); border-color: var(--line); }

    /* ================= MODAL ================= */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 90;
      background: rgba(0,0,0,.66);
      display: flex; align-items: center; justify-content: center;
      padding: 1.2rem;
    }
    .modal-backdrop[hidden] { display: none; }
    .modal {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 5px;
      width: 100%; max-width: 480px;
      max-height: 90vh; overflow-y: auto;
      box-shadow: 0 18px 50px rgba(0,0,0,.5);
    }
    .modal-head {
      display: flex; align-items: center; gap: .7rem;
      padding: .8rem 1rem;
      background: var(--panel-head);
      border-bottom: 1px solid var(--line);
      font-size: .82rem;
    }
    .modal-head b { color: var(--accent); }
    .modal-close {
      margin-left: auto; background: none; border: 0; cursor: pointer;
      color: var(--text-dim); font-size: 1.25rem; line-height: 1;
      padding: 0 .2rem;
    }
    .modal-close:hover { color: var(--text); }
    .modal-body { padding: 1rem; }
    .modal-foot {
      display: flex; gap: .55rem; flex-wrap: wrap;
      padding: .8rem 1rem;
      border-top: 1px solid var(--line);
    }

    /* ================= HASIL HAPUS CLIENT ================= */
    .banner-ok, .banner-sisa {
      display: flex; align-items: flex-start; gap: 0.7rem;
      padding: 0.7rem 0.95rem;
      border-radius: 4px;
      margin-bottom: 1.1rem;
      font-size: 0.8rem;
      line-height: 1.55;
    }
    .banner-ok {
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      background: rgba(61,216,138,.06);
      color: var(--text-dim);
    }
    .banner-ok b { color: var(--accent); font-weight: 600; }
    .banner-sisa {
      border: 1px solid rgba(219,179,82,.3);
      border-left: 3px solid var(--warn);
      background: rgba(219,179,82,.07);
      color: #e3d3a8;
    }
    .banner-sisa b { color: var(--warn); font-weight: 700; }
    /* Perintah pembersihan panjang: biarkan membungkus, jangan memaksa
       scroll horizontal pada seluruh halaman. */
    .banner-sisa code {
      display: block;
      margin-top: 0.4rem;
      padding: 0.35rem 0.5rem;
      background: rgba(0,0,0,.35);
      border: 1px solid rgba(219,179,82,.2);
      border-radius: 3px;
      color: #f0e4c4;
      font-size: 0.72rem;
      white-space: pre-wrap;
      word-break: break-all;
    }

    /* ================= VERSI AGENT ================= */
    /* Biru-info, bukan merah/kuning: agent tertinggal versi adalah pekerjaan
       rumah, bukan insiden. Warna alert disisakan untuk hal yang benar-benar
       mendesak supaya tidak kehilangan makna. */
    .banner-update {
      display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap;
      padding: 0.7rem 0.95rem;
      border: 1px solid rgba(86,184,212,.3);
      border-left: 3px solid var(--info);
      background: rgba(86,184,212,.07);
      border-radius: 4px;
      margin-bottom: 1.1rem;
      font-size: 0.8rem;
      color: #bcdde8;
    }
    .banner-update .count { font-weight: 700; color: var(--info); }
    .banner-update b { color: var(--info); font-weight: 700; }
    .update-status { color: var(--text-dim); font-size: 0.73rem; }

    .agent-ver {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.1rem 0.45rem;
      font-size: 0.66rem;
      font-weight: 600;
      border: 1px solid transparent;
      border-radius: 999px;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
      cursor: help;
    }
    .agent-ok { color: var(--text-faint); }
    .agent-old {
      color: var(--info);
      background: rgba(86,184,212,.1);
      border-color: rgba(86,184,212,.3);
    }

    /* ================= IP CHIP ================= */
    .ip-row { display: flex; gap: 0.55rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
    .ip-chip {
      display: inline-flex;
      align-items: stretch;
      border: 1px solid var(--line);
      background: rgba(61, 216, 138, 0.035);
      font-size: 0.75rem;
      clip-path: polygon(7px 0, 100% 0, 100% calc(100% - 7px), calc(100% - 7px) 100%, 0 100%, 0 7px);
    }
    .ip-chip .ip-label {
      padding: 0.3rem 0.55rem;
      background: rgba(61, 216, 138, 0.09);
      color: var(--text-dim);
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
    }
    .ip-chip .ip-value {
      padding: 0.3rem 0.65rem;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      display: flex;
      align-items: center;
    }
    td .ip-stack { display: flex; flex-direction: column; line-height: 1.45; }
    td .ip-stack .ip-priv { color: var(--text); font-size: 0.78rem; font-variant-numeric: tabular-nums; }
    td .ip-stack .ip-pub { color: var(--text-faint); font-size: 0.68rem; font-variant-numeric: tabular-nums; }

    /* Indikator data live (titik berdenyut) */
    .live-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--accent);
      display: inline-block;
      margin-right: 0.15rem;
      animation: livePulse 2s ease-in-out infinite;
    }
    @keyframes livePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }

    /* ================= LATENCY ================= */
    .latency {
      display: inline-flex;
      align-items: baseline;
      gap: 0.15rem;
      font-variant-numeric: tabular-nums;
      font-weight: 600;
      font-size: 0.82rem;
    }
    .latency .unit { font-size: 0.64rem; font-weight: 400; opacity: .75; }
    .lat-good { color: var(--accent); }
    .lat-ok { color: var(--warn); }
    .lat-bad { color: var(--danger); }

    /* ================= STAT CARD ================= */
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(186px, 1fr)); gap: 0.85rem; margin: 1rem 0; }
    .stat-card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 0.9rem 1rem;
      position: relative;
      overflow: hidden;
    }
    .stat-card::before {
      content: '';
      position: absolute; left: 0; top: 0; bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, var(--accent), transparent 85%);
      opacity: .7;
    }
    .stat-card .label { color: var(--text-dim); font-size: 0.6rem; letter-spacing: 0.17em; text-transform: uppercase; margin-bottom: 0.45rem; }
    .stat-card .value { font-size: 1.22rem; font-weight: 700; color: var(--text); line-height: 1.3; font-variant-numeric: tabular-nums; }
    .stat-card .sub { color: var(--text-dim); font-size: 0.7rem; margin-top: 0.25rem; font-variant-numeric: tabular-nums; }

    .chart-shell {
      background: rgba(0,0,0,.45);
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 1rem;
    }

    .row-actions { display: flex; gap: 0.4rem; justify-content: flex-end; }

    @media (max-width: 760px) {
      header { padding: 0.6rem 0.9rem; }
      main { padding: 1.2rem 0.9rem 3rem; }
      .brand-text .sub { display: none; }
      .nav-btn { padding: 0.44rem 0.6rem; }
      thead th, tbody td { padding: 0.6rem; }
    }
  </style>
</head>
