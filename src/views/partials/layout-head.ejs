<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Oops' %></title>
  <style>
    :root { color-scheme: light dark; }
    body { font-family: system-ui, sans-serif; margin: 0; padding: 0; background: #0f1115; color: #e6e6e6; }
    header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; background: #161922; border-bottom: 1px solid #262a36; }
    header a { color: #e6e6e6; text-decoration: none; font-weight: 600; }
    main { padding: 1.5rem; max-width: 1200px; margin: 0 auto; }
    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #262a36; }
    th { color: #9aa0ac; font-weight: 500; font-size: 0.85rem; text-transform: uppercase; }
    .badge { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; }
    .badge-up { background: #123d1f; color: #4ade80; }
    .badge-down { background: #3d1212; color: #f87171; }
    .badge-unreachable { background: #3d3512; color: #facc15; }
    .badge-unknown { background: #262a36; color: #9aa0ac; }
    .badge-pending { background: #1e2a4a; color: #7dd3fc; }
    .code-box { background: #161922; border: 1px solid #262a36; border-radius: 6px; padding: 1rem; font-family: ui-monospace, monospace; font-size: 0.85rem; word-break: break-all; white-space: pre-wrap; }
    .group-label { color: #9aa0ac; font-size: 0.85rem; text-transform: uppercase; margin-top: 1.5rem; }
    pre { background: #161922; padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 0.85rem; }
    a.server-link { color: #7dd3fc; text-decoration: none; }
    a.server-link:hover { text-decoration: underline; }
    form.inline { display: inline; }
    input, button { font: inherit; }
    input[type="text"], input[type="password"] { padding: 0.5rem; border-radius: 4px; border: 1px solid #262a36; background: #0f1115; color: #e6e6e6; width: 100%; box-sizing: border-box; }
    button { padding: 0.5rem 1rem; border-radius: 4px; border: none; background: #2563eb; color: white; cursor: pointer; }
    .error { color: #f87171; margin-bottom: 1rem; }
    .login-box { max-width: 320px; margin: 4rem auto; }
    .meta { color: #9aa0ac; font-size: 0.85rem; }
    .usage-bar { width: 70px; height: 8px; border-radius: 4px; background: #262a36; overflow: hidden; display: inline-block; vertical-align: middle; }
    .usage-bar-fill { display: block; height: 100%; }
    .usage-ok { background: #4ade80; }
    .usage-warn { background: #facc15; }
    .usage-crit { background: #f87171; }
    .usage-label { font-size: 0.8rem; color: #9aa0ac; margin-left: 0.4rem; }
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin: 1rem 0; }
    .stat-card { background: #161922; border-radius: 6px; padding: 1rem; }
    .stat-card .label { color: #9aa0ac; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.4rem; }
    .stat-card .value { font-size: 1.4rem; font-weight: 600; }
    .stat-card .sub { color: #9aa0ac; font-size: 0.8rem; margin-top: 0.2rem; }
  </style>
</head>
<body>
